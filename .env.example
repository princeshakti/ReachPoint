# Copy this file to .env and add your key. .env is gitignored, so it stays on your machine.
#
# Create a key at https://console.cloud.google.com/google/maps-apis, turn on billing, and enable:
#   - Maps JavaScript API
#   - Geocoding API
#   - Places API (New)

# Required. Used for the map, address lookup and nearby-resource search.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional. A separate key for the browser map, restricted by HTTP referrer.
# Leave it out to use GOOGLE_MAPS_API_KEY for everything.
# GOOGLE_MAPS_BROWSER_KEY=
